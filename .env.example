# Copy to .env for local development. Set these in the host's Secrets UI for production.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/calendar.sqlite
OWNER_EMAIL=accounting@borismtax.com
MAIL_FROM="BMT Calendar <scheduling@mail.borismtax.com>"
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional one-time migration pin: set only to the independently verified OLD
# client ID while GOOGLE_CLIENT_ID still equals it, after a verified DB backup.
# Unknown legacy tokens stay disconnected unless pinned or reconnected.
# GOOGLE_LEGACY_CLIENT_ID=
# Generate privately with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and back it up securely: it encrypts Google refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=
DEMO_MODE=false
# Set to the exact number of trusted reverse proxies in front of this process.
# TRUST_PROXY_HOPS=1
